{
  "title": "City world model",
  "subtitle": "One street, seen as a loop. Walk through how a city is captured, checked, understood, and updated again.",
  "cta": "Scroll to begin",
  "startS": -118,
  "chapters": [
    {
      "id": "capture",
      "title": "Capture",
      "start": -125,
      "body": "We photograph the city street by street. Frames come from our own cameras and from a fleet of drivers who pass the same streets again and again.",
      "widget": "capture",
      "items": [
        "Own cameras",
        "Driver fleet"
      ]
    },
    {
      "id": "gate",
      "title": "Quality gate",
      "start": -80,
      "body": "Not every frame is useful. The server rejects the frames we don't need and passes the rest on.",
      "widget": "gate"
    },
    {
      "id": "detect",
      "title": "Detection",
      "start": -38,
      "body": "In the frames that pass, we detect violations: damaged fences and street lights, illegal advertising, graffiti, holes in the road surface.",
      "widget": "detect"
    },
    {
      "id": "registry",
      "title": "Asset registry",
      "start": 30,
      "body": "Every detection becomes a record in a database of assets, grouped by violation category.",
      "widget": "registry"
    },
    {
      "id": "case",
      "title": "Case",
      "start": 78,
      "body": "From the registry we build a case: literally a narrative about what is wrong in the city, and where.",
      "widget": "case"
    },
    {
      "id": "refresh",
      "title": "Reupdated",
      "start": 108,
      "body": "City data is dynamic and changes every day. When a road gets repaired, it is no longer a problem. So the loop starts again.",
      "widget": "refresh"
    }
  ],
